---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import ContactForm from '../components/blocks/ContactForm.astro';
import { getDictionary } from '../i18n/dictionary';
import type { Locale } from '../lib/i18n';
import { CONTACT, PHONE_TEL, TELEGRAM_OWNER, TELEGRAM_BOT_HANDLE } from '../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const presetService = Astro.url.searchParams.get('service') ?? undefined;
const presetLocation = Astro.url.searchParams.get('location') ?? undefined;

const title = `${t.form.heading} | FORMA`;
const description = t.form.intro;
---

<BaseLayout locale={locale} path="/contact/" title={title} description={description} pageType="ContactPage">
  <Breadcrumbs locale={locale} items={[{ name: t.nav.contact, path: '/contact/' }]} />

  <section class="wrap py-14 sm:py-20">
    <div class="content-grid">
      <div class="col-span-4 md:col-span-3 lg:col-span-4">
        <h1>{t.form.heading}</h1>
        <p class="body-l mt-4 text-ink-900/70">{t.form.intro}</p>

        <div class="mt-10 space-y-4 border-t border-ink-900/10 pt-8">
          <a href={`mailto:${CONTACT.email}`} class="block text-sm font-medium hover:text-olive-700">
            <bdi>{CONTACT.email}</bdi>
          </a>
          <a href={`https://wa.me/${CONTACT.whatsapp.replace(/[^\d]/g, '')}`} class="block text-sm font-medium hover:text-olive-700">
            WhatsApp
          </a>
          <a href={PHONE_TEL} class="block text-sm font-medium hover:text-olive-700"><bdi dir="ltr">{CONTACT.phone}</bdi></a>
          <a href={TELEGRAM_OWNER} class="block text-sm font-medium hover:text-olive-700">Telegram · <bdi dir="ltr">{CONTACT.phone}</bdi></a>
          {TELEGRAM_BOT_HANDLE && <a href={CONTACT.telegram} class="block text-sm font-medium hover:text-olive-700"><bdi dir="ltr">{TELEGRAM_BOT_HANDLE}</bdi></a>}
          <p class="text-sm text-ink-900/60">{CONTACT.addressLocality}, {CONTACT.addressRegion}, Thailand</p>
        </div>
      </div>

      <div class="col-span-4 md:col-span-5 lg:col-span-7 lg:col-start-6">
        <ContactForm locale={locale} presetService={presetService} presetLocation={presetLocation} />
      </div>
    </div>
  </section>
</BaseLayout>
