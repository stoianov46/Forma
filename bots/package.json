{
  "name": "forma-bots",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram and WhatsApp project-intake bots for FORMA \u2014 standalone from the Astro site build.",
  "scripts": {
    "telegram": "tsx watch telegram/index.ts",
    "telegram:start": "tsx telegram/index.ts",
    "whatsapp": "tsx watch whatsapp/index.ts",
    "whatsapp:start": "tsx whatsapp/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
