# Environment variables for the Cloudflare Pages Function at functions/api/lead.ts
# (the site's contact form intake). Set these in the Cloudflare Pages project settings —
# never commit real values.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: bind a KV namespace named LEAD_RATE_LIMIT_KV in the Cloudflare Pages dashboard
# for basic per-IP rate limiting on the lead form. Without it, rate limiting is skipped
# (see functions/api/lead.ts).

# Optional: where the contact form POSTs. Leave unset on Cloudflare Pages (defaults to
# /api/lead). Set it only when the static site is hosted without functions (e.g. GitHub
# Pages) and functions/api/lead.ts runs elsewhere. Never put the bot token in the client.
PUBLIC_LEAD_ENDPOINT=

# Optional (Cloudflare Pages Function): comma-separated origins allowed to POST to
# /api/lead cross-origin — needed only when PUBLIC_LEAD_ENDPOINT points here from
# another host, e.g. LEAD_ALLOWED_ORIGINS=https://drandromeda.github.io
LEAD_ALLOWED_ORIGINS=

# The bots/ directory (Telegram + WhatsApp intake bots) is a separate standalone Node
# project with its own .env — see bots/.env.example.

# --- Site build-time facts (src/lib/site.ts) ---------------------------------------
# This site is fully static (output: 'static'), so every PUBLIC_* var below is baked
# into the generated HTML at build time — these are NOT secrets (the values end up
# in publicly visible page content either way), just a way to set real business/legal
# facts via this env file (or your host's env var dashboard) and a rebuild, instead of
# a source-code edit. Leave unset to keep the current placeholder/[[VERIFY]] defaults.

PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_WHATSAPP=
PUBLIC_CONTACT_TELEGRAM=
# Street address is optional — only included in schema.org markup if set.
PUBLIC_CONTACT_ADDRESS_LINE1=
PUBLIC_CONTACT_ADDRESS_LINE2=
PUBLIC_CONTACT_ADDRESS_LOCALITY=
PUBLIC_CONTACT_ADDRESS_REGION=
PUBLIC_CONTACT_ADDRESS_POSTCODE=
PUBLIC_CONTACT_ADDRESS_COUNTRY=

# Comma-separated social profile URLs (schema.org sameAs), e.g.:
# PUBLIC_SOCIAL_LINKS=https://instagram.com/forma,https://facebook.com/forma
PUBLIC_SOCIAL_LINKS=

# Legal specifics — only set these once confirmed with real legal counsel; never guess
# a governing-law clause or retention period. Left unset, the legal pages keep their
# explicit [[VERIFY]] markers rather than silently shipping fabricated legal content.
PUBLIC_LEGAL_UPDATED_DATE=
PUBLIC_LEGAL_RETENTION_PERIOD=
PUBLIC_LEGAL_GOVERNING_LAW=

# Analytics (src/components/layout/Analytics.astro) — only loads a script, and only
# after real visitor consent, once one of these is set. Neither is required.
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_YANDEX_METRICA_ID=
