---
interface Step {
  title: string;
  body: string;
}
interface Props {
  heading?: string;
  intro?: string;
  steps: Step[];
}
const { heading, intro, steps } = Astro.props;
// Avoid a lone step on the last row: 4 or 7 steps read better 4-up than 3-up.
const wideCols = steps.length % 3 === 1 && steps.length % 4 !== 1 ? 'lg:grid-cols-4' : 'lg:grid-cols-3';
---

<section class="wrap py-14 sm:py-20">
  {heading && (
    <div class="mb-10 max-w-xl">
      <h2>{heading}</h2>
      {intro && <p class="body-l mt-3 text-ink-900/70">{intro}</p>}
    </div>
  )}
  <ol class:list={['grid gap-8 sm:grid-cols-2 lg:gap-x-10', wideCols]}>
    {
      steps.map((step, i) => (
        <li class="relative border-t border-ink-900/15 pt-6">
          <span class="font-display text-3xl text-olive-600">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-xl">{step.title}</h3>
          <p class="body-m mt-2 text-ink-900/70">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
