---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary } from '../i18n/dictionary';
import { withBase, LOCALES, LOCALE_HTML_LANG, RTL_LOCALES } from '../lib/i18n';

const t = getDictionary('en');
// One static 404.html serves every locale (the host returns it for any unknown URL). It is rendered in English and
// switched on the client to the language of the URL prefix (/ru/, /th/, /he/), so a broken Hebrew link shows Hebrew.
const texts = Object.fromEntries(
  LOCALES.map((l) => {
    const d = getDictionary(l);
    return [l, { title: d.notFound.title, body: d.notFound.body, cta: d.notFound.cta, home: withBase(l === 'en' ? '/' : `/${l}/`), lang: LOCALE_HTML_LANG[l], dir: RTL_LOCALES.includes(l) ? 'rtl' : 'ltr' }];
  }),
);
const base = withBase('/');
---

<BaseLayout locale="en" path="/" title={`${t.notFound.title} | FORMA`} description={t.notFound.body} noindex availableLocales={['en']}>
  <section class="wrap flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-display text-6xl text-olive-600">404</p>
    <h1 id="nf-title" class="mt-4 max-w-xl">{t.notFound.title}</h1>
    <p id="nf-body" class="body-l mt-4 max-w-md text-ink-900/70">{t.notFound.body}</p>
    <a id="nf-cta" href={withBase('/')} class="mt-8 inline-flex items-center rounded-full bg-ink-900 px-6 py-3 text-sm font-medium text-stone-50 hover:bg-olive-700">
      {t.notFound.cta}
    </a>
  </section>
</BaseLayout>

<script define:vars={{ texts, base }}>
  const rest = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname.replace(/^\//, '');
  const loc = rest.split('/')[0];
  const t = texts[loc];
  if (t && loc !== 'en') {
    document.documentElement.lang = t.lang;
    document.documentElement.dir = t.dir;
    document.title = t.title + ' | FORMA';
    const set = (id, text) => { const el = document.getElementById(id); if (el) el.textContent = text; };
    set('nf-title', t.title);
    set('nf-body', t.body);
    set('nf-cta', t.cta);
    const cta = document.getElementById('nf-cta');
    if (cta) cta.setAttribute('href', t.home);
  }
</script>
