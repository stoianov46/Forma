{
  "name": "forma-in-th",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "qa:links": "node scripts/qa/linkcheck.cjs",
    "qa:meta": "node scripts/qa/metacheck.cjs",
    "qa:jsonld": "node scripts/qa/jsonldcheck.cjs",
    "qa:static": "npm run qa:links && npm run qa:meta && npm run qa:jsonld",
    "i18n:check": "node scripts/i18n-check.mjs",
    "plan:check": "node scripts/plan-check.mjs",
    "nav:check": "node scripts/nav-check.mjs",
    "contact:check": "node scripts/contact-check.mjs",
    "pricing:check": "node scripts/pricing-check.mjs",
    "pricing:master": "node scripts/pricing-check.mjs --write",
    "seo:keywords": "node scripts/keyword-map.mjs",
    "seo:links": "node scripts/linking-map.cjs",
    "seo:audit": "node scripts/seo-audit.cjs",
    "qa:audit": "node scripts/qa/audit.cjs --md > reports/audit-matrix.md",
    "qa:plan": "node scripts/qa/plancheck.cjs",
    "qa:form": "node scripts/qa/formcheck.cjs",
    "qa:browser": "node scripts/qa/browsercheck.cjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260911.1",
    "axe-core": "^4.13.0",
    "puppeteer-core": "^25.11.0",
    "typescript": "^5.9.3"
  }
}
