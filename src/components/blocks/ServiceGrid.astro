---
import { Image } from 'astro:assets';
import { getImage } from '../../lib/images';
import { serviceHrefSmart } from '../../content/services';
import type { Service } from '../../lib/types';
import type { Locale } from '../../lib/i18n';
import { getDictionary } from '../../i18n/dictionary';

interface Props {
  locale: Locale;
  services: Service[];
  heading?: string;
  intro?: string;
  viewAllHref?: string;
  /** Cards per row on wide screens (≥90rem, the 12-column grid). 4 suits 8 cards; default 3. */
  columns?: 3 | 4;
  /** Extra services rendered as a compact linked list below the cards. */
  moreServices?: Service[];
  moreServicesHeading?: string;
}
const { locale, services, heading, intro, viewAllHref, columns = 3, moreServices = [], moreServicesHeading } = Astro.props;
const span = columns === 4 ? 'min-[90rem]:col-span-3' : 'min-[90rem]:col-span-4';
const imageSizes = columns === 4 ? '(min-width: 90rem) 22rem, (min-width: 48rem) 50vw, 100vw' : '(min-width: 90rem) 28rem, (min-width: 48rem) 50vw, 100vw';
const t = getDictionary(locale);
---

<section class="wrap py-14 sm:py-20">
  {
    (heading || intro) && (
      <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          {heading && <h2>{heading}</h2>}
          {intro && <p class="body-l mt-3 max-w-xl text-ink-900/70">{intro}</p>}
        </div>
        {viewAllHref && (
          <a href={viewAllHref} class="text-sm font-medium text-olive-700 hover:text-olive-600 whitespace-nowrap">
            {t.nav.viewAllServices} →
          </a>
        )}
      </div>
    )
  }
  <div class="content-grid">
    {
      services.map((s) => {
        const tr = s.translations[locale];
        return (
          <a href={serviceHrefSmart(locale, s.slug)} class:list={['group col-span-4 flex flex-col overflow-hidden rounded-2xl border border-ink-900/10 bg-stone-50 transition-shadow hover:shadow-lg', span]}>
            <div class="aspect-[4/3] overflow-hidden">
              <Image
                src={getImage(s.image)}
                alt=""
                width={640}
                height={480}
                widths={[320, 480, 640]}
                sizes={imageSizes}
                format="avif"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-lg">{tr.navLabel}</h3>
              <p class="mt-2 flex-1 text-sm text-ink-900/70">{tr.cardSummary}</p>
              <span class="mt-4 text-sm font-medium text-olive-700">{t.common.viewService} →</span>
            </div>
          </a>
        );
      })
    }
  </div>
  {
    moreServices.length > 0 && (
      <div class="mt-12 border-t border-ink-900/10 pt-8">
        {moreServicesHeading && <h3 class="text-lg">{moreServicesHeading}</h3>}
        <ul class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2 min-[90rem]:grid-cols-3">
          {moreServices.map((s) => (
            <li>
              <a href={serviceHrefSmart(locale, s.slug)} class="group flex items-baseline justify-between gap-4 border-b border-ink-900/10 py-3 hover:border-ink-900/40">
                <span class="font-medium">{s.translations[locale].navLabel}</span>
                <span class="text-sm text-olive-700 transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>
