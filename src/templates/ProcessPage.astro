---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import DirectAnswer from '../components/blocks/DirectAnswer.astro';
import EditorialIntro from '../components/blocks/EditorialIntro.astro';
import ProcessStages from '../components/blocks/ProcessStages.astro';
import FAQAccordion from '../components/blocks/FAQAccordion.astro';
import CTABanner from '../components/blocks/CTABanner.astro';
import { getDictionary } from '../i18n/dictionary';
import { localizePath, LOCALES, type Locale } from '../lib/i18n';
import { getProcessContent, isProcessTranslated } from '../content/process';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const p = getProcessContent(locale);
const availableLocales = LOCALES.filter((l) => l === 'en' || isProcessTranslated(l));
---

<BaseLayout locale={locale} path="/process/" title={p.seo.title} description={p.seo.description} availableLocales={availableLocales}>
  <Breadcrumbs locale={locale} items={[{ name: t.nav.process, path: '/process/' }]} />
  <section class="wrap pb-6 pt-2">
    <h1 class="max-w-3xl">{p.h1}</h1>
  </section>
  <DirectAnswer text={p.directAnswer} />
  <EditorialIntro heading={p.introHeading} body={p.intro} />
  <ProcessStages stages={p.stages} labels={{ input: t.common.processInput, outputs: t.common.processOutputs, next: t.common.processNext }} />
  <FAQAccordion locale={locale} faqs={p.faqs} />
  <CTABanner heading={p.ctaHeading} body={p.ctaBody} cta={{ label: t.cta.startProject, href: localizePath(locale, '/contact/') }} />
</BaseLayout>
