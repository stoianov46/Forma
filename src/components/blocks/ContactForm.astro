---
import type { Locale } from '../../lib/i18n';
import { getDictionary } from '../../i18n/dictionary';
import { withBase, LOCALES, LOCALE_LABEL } from '../../lib/i18n';
import { services } from '../../content/services';
import { locations } from '../../content/locations';

interface Props {
  locale: Locale;
  presetService?: string;
  presetLocation?: string;
}
const { locale, presetService, presetLocation } = Astro.props;
const t = getDictionary(locale);
// Option VALUES are the stable English strings (validated server-side in functions/_lib/lead-core.ts);
// only the visible labels are translated.
const en = getDictionary('en');
// Lead intake endpoint. Defaults to the Cloudflare Pages Function at
// /api/lead; set PUBLIC_LEAD_ENDPOINT when hosting the static site somewhere
// without functions (e.g. GitHub Pages) and running the endpoint elsewhere.
const leadEndpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT || withBase('/api/lead');
---

<div id="contact-form-root" data-locale={locale}>
  <form id="lead-form" action={leadEndpoint} method="post" class="grid grid-cols-1 gap-5 sm:grid-cols-2" novalidate>
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="sourceUrl" id="source-url" value="" />

    <p class="hidden" aria-hidden="true">
      <label>
        Company
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="sm:col-span-1">
      <label for="name" class="text-sm font-medium">{t.form.name} <span class="text-terracotta-500">*</span></label>
      <input id="name" name="name" type="text" required maxlength="120" class="mt-1.5 w-full rounded-lg border border-ink-900/20 bg-stone-50 px-4 py-3 text-sm focus-visible:border-terracotta-500" />
    </div>

    <div class="sm:col-span-1">
      <label for="email" class="text-sm font-medium">{t.form.email} <span class="text-terracotta-500">*</span></label>
      <input id="email" name="email" type="email" required maxlength="180" class="mt-1.5 w-full rounded-lg border border-ink-900/20 bg-stone-50 px-4 py-3 text-sm focus-visible:border-terracotta-500" />
    </div>

    <div class="sm:col-span-1">
      <label for="whatsapp" class="text-sm font-medium">{t.form.whatsapp}</label>
      <input id="whatsapp" name="whatsapp" type="tel" maxlength="40" class="mt-1.5 w-full rounded-lg border border-ink-900/20 bg-stone-50 px-4 py-3 text-sm focus-visible:border-terracotta-500" />
    </div>

    <div class="sm:col-span-1">
      <label for="projectType" class="text-sm font-medium">{t.form.projectType} <span class="text-terracotta-500">*</span></label>
      <select id="projectType" name="projectType" required class="mt-1.5 w-full rounded-lg border border-ink-900/20 bg-stone-50 px-4 py-3 text-sm focus-visible:border-terracotta-500">
        {t.form.projectTypeOptions.map((label, i) => <option value={en.form.projectTypeOptions[i]}>{label}</option>)}
      </select>
    </div>

    <div class="sm:col-span-1">
      <label for="service" class="text-sm font-medium">{t.nav.services}</label>
      <select id="service" name="service" class="mt-1.5 w-full rounded-lg border border-ink-900/20 bg-stone-50 px-4 py-3 text-sm focus-visible:border-terracotta-500">
        <option value="">—</option>
        {services.map((s) => (
          <option value={s.slug} selected={s.slug === presetService}>{s.translations[locale].navLabel}</option>
        ))}
      </select>
    </div>

    <div class="sm:col-span-1">
      <label for="location" class="text-sm font-medium">{t.form.location}</label>
      <select id="location" name="location" class="mt-1.5 w-full rounded-lg border border-ink-900/20 bg-stone-50 px-4 py-3 text-sm focus-visible:border-terracotta-500">
        <option value="">—</option>
        {locations.map((l) => (
          <option value={l.slug} selected={l.slug === presetLocation}>{l.translations[locale].name}</option>
        ))}
      </select>
    </div>

    <div class="sm:col-span-1">
      <label for="budget" class="text-sm font-medium">{t.form.budget}</label>
      <input id="budget" name="budget" type="text" maxlength="80" placeholder={t.form.budgetOptional} class="mt-1.5 w-full rounded-lg border border-ink-900/20 bg-stone-50 px-4 py-3 text-sm focus-visible:border-terracotta-500" />
    </div>

    <div class="sm:col-span-1">
      <label for="preferredContact" class="text-sm font-medium">{t.form.preferredContact}</label>
      <select id="preferredContact" name="preferredContact" class="mt-1.5 w-full rounded-lg border border-ink-900/20 bg-stone-50 px-4 py-3 text-sm focus-visible:border-terracotta-500">
        {t.form.contactMethodOptions.map((label, i) => <option value={en.form.contactMethodOptions[i]}>{label}</option>)}
      </select>
    </div>

    <div class="sm:col-span-1">
      <label for="landStatus" class="text-sm font-medium">{t.form.landStatus}</label>
      <select id="landStatus" name="landStatus" class="mt-1.5 w-full rounded-lg border border-ink-900/20 bg-stone-50 px-4 py-3 text-sm focus-visible:border-terracotta-500">
        <option value="">—</option>
        {t.form.landOptions.map((label, i) => <option value={en.form.landOptions[i]}>{label}</option>)}
      </select>
    </div>

    <div class="sm:col-span-1">
      <label for="replyLanguage" class="text-sm font-medium">{t.form.replyLanguage}</label>
      <select id="replyLanguage" name="replyLanguage" class="mt-1.5 w-full rounded-lg border border-ink-900/20 bg-stone-50 px-4 py-3 text-sm focus-visible:border-terracotta-500">
        {LOCALES.map((l) => <option value={l} selected={l === locale}>{LOCALE_LABEL[l]}</option>)}
      </select>
    </div>

    <div id="lead-attached" hidden class="sm:col-span-2 rounded-xl bg-olive-600/10 p-4 text-sm">
      <p class="text-xs font-semibold tracking-wide text-olive-700 uppercase">{t.form.attached}</p>
      <p id="lead-attached-text" class="mt-1 text-ink-900/80"></p>
    </div>

    <div class="sm:col-span-2">
      <label for="message" class="text-sm font-medium">{t.form.message} <span class="text-terracotta-500">*</span></label>
      <textarea id="message" name="message" required minlength="10" maxlength="4000" rows="5" class="mt-1.5 w-full rounded-lg border border-ink-900/20 bg-stone-50 px-4 py-3 text-sm focus-visible:border-terracotta-500"></textarea>
    </div>

    <div id="lead-submit-row" class="sm:col-span-2">
      <button type="submit" id="lead-submit" class="inline-flex items-center justify-center rounded-full bg-ink-900 px-7 py-3.5 text-sm font-medium text-stone-50 transition-colors hover:bg-olive-700 disabled:opacity-60">
        {t.form.submit}
      </button>
      <p class="body-m mt-4 text-ink-900/60">{t.form.privacyNotice}</p>
    </div>

    <div id="lead-review" hidden class="sm:col-span-2 rounded-xl border border-ink-900/15 bg-stone-100 p-6">
      <h2 class="text-xl">{t.form.reviewHeading}</h2>
      <p class="body-m mt-1 text-ink-900/70">{t.form.reviewHint}</p>
      <dl id="lead-review-list" class="mt-5 grid gap-3 text-sm sm:grid-cols-2"></dl>
      <div class="mt-6 flex flex-wrap gap-3">
        <button type="button" id="lead-edit" class="rounded-full border border-ink-900/25 px-6 py-3 text-sm font-medium hover:bg-stone-50">{t.form.edit}</button>
        <button type="button" id="lead-send" class="rounded-full bg-ink-900 px-7 py-3 text-sm font-medium text-stone-50 hover:bg-olive-700 disabled:opacity-60">{t.form.send}</button>
      </div>
    </div>

    <div id="lead-success" role="status" class="hidden sm:col-span-2 rounded-xl bg-olive-600/10 p-5">
      <p class="font-medium text-olive-700">{t.form.successTitle}</p>
      <p class="body-m mt-1 text-ink-900/70">{t.form.successBody}</p>
    </div>
    <div id="lead-error" role="alert" class="hidden sm:col-span-2 rounded-xl bg-terracotta-500/10 p-5">
      <p class="font-medium text-terracotta-600">{t.form.errorTitle}</p>
      <p class="body-m mt-1 text-ink-900/70">{t.form.errorBody}</p>
    </div>
  </form>
</div>

<script define:vars={{ sendLabel: t.form.send, reviewLabel: t.form.review, sendingLabel: t.form.submitting }}>
  const form = document.getElementById('lead-form');
  const submitBtn = document.getElementById('lead-submit');
  const submitRow = document.getElementById('lead-submit-row');
  const reviewBox = document.getElementById('lead-review');
  const reviewList = document.getElementById('lead-review-list');
  const editBtn = document.getElementById('lead-edit');
  const sendBtn = document.getElementById('lead-send');
  const successBox = document.getElementById('lead-success');
  const errorBox = document.getElementById('lead-error');
  const sourceUrlInput = document.getElementById('source-url');

  if (sourceUrlInput) sourceUrlInput.value = window.location.href;
  // With JavaScript the first press opens the review step; without it the form posts directly.
  if (submitBtn) submitBtn.textContent = reviewLabel;

  const params = new URLSearchParams(window.location.search);
  // Summary attached by the /plan/ tools (estimator / service finder): shown to the visitor and sent as hidden fields.
  const planText = (params.get('plan') || '').slice(0, 500);
  const estMin = (params.get('estimateMin') || '').replace(/\D/g, '').slice(0, 12);
  const estMax = (params.get('estimateMax') || '').replace(/\D/g, '').slice(0, 12);
  if (planText && form instanceof HTMLFormElement) {
    const attached = document.getElementById('lead-attached');
    const attachedText = document.getElementById('lead-attached-text');
    if (attached && attachedText) {
      attachedText.textContent = planText;
      attached.hidden = false;
    }
    [['planSummary', planText], ['estimateMin', estMin], ['estimateMax', estMax]].forEach(([name, value]) => {
      if (!value) return;
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = name;
      input.value = value;
      form.appendChild(input);
    });
  }

  const presetService = params.get('service');
  const presetLocation = params.get('location');
  const serviceSelect = document.getElementById('service');
  const locationSelect = document.getElementById('location');
  if (presetService && serviceSelect instanceof HTMLSelectElement) serviceSelect.value = presetService;
  if (presetLocation && locationSelect instanceof HTMLSelectElement) locationSelect.value = presetLocation;

  // First-touch attribution (landing page, referrer host, UTM) is stored for the session by
  // Attribution.astro only after analytics consent. UTM values in this page's own URL always apply.
  function setHidden(name, value) {
    if (!value || !(form instanceof HTMLFormElement)) return;
    let el = form.querySelector('input[type="hidden"][name="' + name + '"]');
    if (!el) {
      el = document.createElement('input');
      el.type = 'hidden';
      el.name = name;
      form.appendChild(el);
    }
    el.value = value;
  }
  function applyAttribution() {
    let stored = {};
    try {
      stored = JSON.parse(sessionStorage.getItem('formaAttribution') || '{}');
    } catch {}
    ['landingPage', 'referrer', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((k) => setHidden(k, stored[k]));
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((k) => setHidden(k, params.get(k)));
  }

  function labelFor(id) {
    const l = document.querySelector('label[for="' + id + '"]');
    return l ? l.textContent.replace('*', '').trim() : id;
  }
  function shownValue(id) {
    const el = document.getElementById(id);
    if (!el) return '';
    if (el instanceof HTMLSelectElement) return el.value ? el.options[el.selectedIndex].text : '';
    return el.value.trim();
  }
  function buildReview() {
    if (!reviewList) return;
    reviewList.textContent = '';
    ['name', 'email', 'whatsapp', 'projectType', 'service', 'location', 'budget', 'landStatus', 'preferredContact', 'replyLanguage', 'message'].forEach((id) => {
      const v = shownValue(id);
      if (!v) return;
      const wrap = document.createElement('div');
      if (id === 'message') wrap.className = 'sm:col-span-2';
      const dt = document.createElement('dt');
      dt.className = 'text-xs font-semibold tracking-wide text-ink-900/60 uppercase';
      dt.textContent = labelFor(id);
      const dd = document.createElement('dd');
      dd.className = 'mt-0.5 whitespace-pre-wrap text-ink-900';
      dd.textContent = v;
      wrap.append(dt, dd);
      reviewList.append(wrap);
    });
  }
  function fieldsVisible(visible) {
    if (!(form instanceof HTMLFormElement)) return;
    Array.from(form.children).forEach((child) => {
      if (child === reviewBox || child === successBox || child === errorBox) return;
      if (child instanceof HTMLInputElement && child.type === 'hidden') return;
      if (child.id === 'lead-attached' && !planText) return;
      child.hidden = !visible;
    });
    if (reviewBox) reviewBox.hidden = visible;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    successBox?.classList.add('hidden');
    errorBox?.classList.add('hidden');
    buildReview();
    fieldsVisible(false);
    reviewBox?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  editBtn?.addEventListener('click', () => {
    fieldsVisible(true);
    form?.querySelector('input, select, textarea')?.focus();
  });

  sendBtn?.addEventListener('click', async () => {
    if (!(form instanceof HTMLFormElement)) return;
    successBox?.classList.add('hidden');
    errorBox?.classList.add('hidden');
    applyAttribution();
    if (sendBtn instanceof HTMLButtonElement) {
      sendBtn.disabled = true;
      sendBtn.textContent = sendingLabel;
    }
    try {
      // Submitted to the server-side intake endpoint (functions/api/lead.ts by default). It holds
      // the Telegram/email/webhook secrets. Never call those APIs from here: anything in this
      // script ships to every visitor.
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      if (!res.ok) throw new Error('Request failed');
      form.reset();
      fieldsVisible(true);
      if (reviewBox) reviewBox.hidden = true;
      successBox?.classList.remove('hidden');
      successBox?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      // Keep everything the visitor typed: go back to the review step so they can resend.
      errorBox?.classList.remove('hidden');
    } finally {
      if (sendBtn instanceof HTMLButtonElement) {
        sendBtn.disabled = false;
        sendBtn.textContent = sendLabel;
      }
    }
  });
</script>
